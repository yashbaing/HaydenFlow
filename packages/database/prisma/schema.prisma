generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ====== Asset ======

model Asset {
  id             String   @id @default(cuid())
  symbol         String   @unique
  name           String
  assetType      String   // STOCK | ETF | CRYPTO | COMMODITY | STABLECOIN
  sector         String
  tokenAddress   String   @unique
  decimals       Int
  benchmarkSymbol String?
  isBridgeAsset  Boolean  @default(false)
  logoColor      String
  currentPrice   Float    @default(0)
  priceChange24h Float    @default(0)
  marketCap      Float?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  priceHistory   PriceHistory[]
  correlationsA  Correlation[]  @relation("AssetA")
  correlationsB  Correlation[]  @relation("AssetB")

  @@map("assets")
}

// ====== Pool ======

model Pool {
  id                      String   @id @default(cuid())
  poolId                  String   @unique // bytes32 on-chain
  token0Symbol            String
  token1Symbol            String
  poolType                String   // CORRELATED | BRIDGE | STABLE
  correlation             Float?
  correlationClassification String?
  feeBps                  Int
  tvl                     Float    @default(0)
  volume24h               Float    @default(0)
  volume7d                Float    @default(0)
  fees24h                 Float    @default(0)
  apr                     Float    @default(0)
  riskLevel               String   @default("MODERATE")
  reserve0                String   @default("0") // bigint as string
  reserve1                String   @default("0")
  totalLpTokens           String   @default("0")
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  volumeHistory  VolumeHistory[]
  lpPositions    LPPosition[]

  @@map("pools")
}

// ====== Price History ======

model PriceHistory {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float    @default(0)

  @@unique([assetId, timestamp])
  @@index([assetId, timestamp])
  @@map("price_history")
}

// ====== Correlation ======

model Correlation {
  id             String   @id @default(cuid())
  assetAId       String
  assetBId       String
  assetA         Asset    @relation("AssetA", fields: [assetAId], references: [id])
  assetB         Asset    @relation("AssetB", fields: [assetBId], references: [id])
  correlation    Float
  classification String   // EXTREME | HIGH | MODERATE | LOW
  dataPoints     Int
  periodDays     Int      @default(90)
  calculatedAt   DateTime @default(now())

  @@unique([assetAId, assetBId])
  @@map("correlations")
}

// ====== Volume History (per pool) ======

model VolumeHistory {
  id        String   @id @default(cuid())
  poolId    String
  pool      Pool     @relation(fields: [poolId], references: [id])
  timestamp DateTime
  volume    Float
  tvl       Float
  fees      Float

  @@unique([poolId, timestamp])
  @@index([poolId, timestamp])
  @@map("volume_history")
}

// ====== LP Position ======

model LPPosition {
  id              String   @id @default(cuid())
  positionId      String   @unique // bytes32 on-chain
  poolId          String
  pool            Pool     @relation(fields: [poolId], references: [id])
  ownerAddress    String
  lpTokens        String   // bigint as string
  token0Deposited Float
  token1Deposited Float
  feesEarned0     String   @default("0")
  feesEarned1     String   @default("0")
  closed          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerAddress])
  @@map("lp_positions")
}

// ====== Protocol Stats (daily snapshots) ======

model ProtocolSnapshot {
  id                         String   @id @default(cuid())
  date                       DateTime @unique
  totalTvl                   Float
  volume24h                  Float
  totalVolume                Float
  fees24h                    Float
  totalFees                  Float
  marketCount                Int
  correlatedMarketCount      Int
  activeLPs                  Int
  createdAt                  DateTime @default(now())

  @@map("protocol_snapshots")
}
