# ========================
# NEXORA Environment Variables
# ========================
# Copy this file to .env and fill in your values

# ------- DATABASE -------
# For local dev, SQLite is used automatically if this is not set
# For production, use a PostgreSQL connection string
DATABASE_URL="file:./dev.db"

# ------- BLOCKCHAIN -------
# Get from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your_project_id_here"

# Get from https://www.alchemy.com (optional, falls back to public RPC)
NEXT_PUBLIC_ALCHEMY_ID="your_alchemy_id_here"

# RPC URLs
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC="https://sepolia-rollup.arbitrum.io/rpc"
NEXT_PUBLIC_LOCAL_RPC="http://127.0.0.1:8545"

# ------- CONTRACTS (populated after deployment) -------
NEXT_PUBLIC_MOCK_USDC_ADDRESS=""
NEXT_PUBLIC_MOCK_NSPY_ADDRESS=""
NEXT_PUBLIC_MOCK_NNVDA_ADDRESS=""
NEXT_PUBLIC_MOCK_NTSLA_ADDRESS=""
NEXT_PUBLIC_MOCK_NAMZN_ADDRESS=""
NEXT_PUBLIC_MOCK_NCOST_ADDRESS=""
NEXT_PUBLIC_MOCK_NQQQ_ADDRESS=""
NEXT_PUBLIC_MOCK_NGOLD_ADDRESS=""
NEXT_PUBLIC_MOCK_WETH_ADDRESS=""
NEXT_PUBLIC_MOCK_WBTC_ADDRESS=""
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=""
NEXT_PUBLIC_POOL_FACTORY_ADDRESS=""
NEXT_PUBLIC_ROUTER_ADDRESS=""
NEXT_PUBLIC_ORACLE_ADDRESS=""
NEXT_PUBLIC_POSITION_MANAGER_ADDRESS=""

# ------- APP -------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_IS_TESTNET="true"
NODE_ENV="development"

# ------- OPTIONAL: Real Market Data (future) -------
# COINGECKO_API_KEY=""
# POLYGON_IO_API_KEY=""
